# Production build config — committed deliberately.
#
# Everything here is a PUBLIC browser identifier: it is baked into the served
# JS bundle by vite build and readable by every visitor, so committing it adds
# no exposure. This file existing in git is what lets isolated builds
# (Cloudflare Workers Builds, CI) produce a working bundle with no env setup.
#
# Never put provider client secrets here. Those are Worker secrets
# (wrangler secret put ...) used only by the token-exchange route (ADR-011).
#
# Redirect URIs default to window.location.origin at runtime when unset.
VITE_DROPBOX_APP_KEY=o62uywl4cmr6o4j
VITE_DROPBOX_REDIRECT_URI=https://app.mudemocracy.org/
VITE_GOOGLE_CLIENT_ID=491229255898-2l6sjttnba8ds59nfls91i78aq6m9ctr.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIzaSyBt-g45Ee4ZCIB_rsu7QzPCc6jbDsVTjgQ
VITE_GOOGLE_APP_ID=491229255898
VITE_GITHUB_CLIENT_ID=Iv23liFJ9ym1hcYQ6TuN
VITE_GITHUB_APP_SLUG=mudemocracy
