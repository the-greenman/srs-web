            "enforcement": "hard",
            "relationType": [
              "supersedes"
            ]
          }
        }
      ],
      "transitions": [
        {
          "description": "Put the argument forward.",
          "from": "draft",
          "id": "db5b2ee2-449c-4e24-885f-97c01cd1356e",
          "name": "propose",
          "to": "proposed"
        },
        {
          "description": "Return for further work.",
          "from": "proposed",
          "id": "feeaf58e-f921-42e0-9a80-9ced5558bb26",
          "name": "revise",
          "to": "draft"
        },
        {
          "description": "Adopt as current position.",
          "from": "proposed",
          "id": "5ea9d0e7-aa1b-4fdb-9eec-24b16e2df849",
          "name": "ratify",
          "to": "ratified"
        },
        {
          "description": "Withdraw without successor.",
          "from": "ratified",
          "id": "4facfed7-5bc3-4953-992d-f57fd9e321e4",
          "name": "withdraw",
          "to": "withdrawn"
        },
        {
          "description": "Withdraw a draft.",
          "from": "draft",
          "id": "8b327998-8cbf-461e-91bf-ca7eaebb4601",
          "name": "withdraw-draft",
          "to": "withdrawn"
        },
        {
          "description": "Replace with successor.",
          "from": "ratified",
          "id": "9b77b0a4-d3a9-4dc0-87bc-a0891cffbb59",
          "name": "supersede",
          "to": "superseded"
        }
      ],
      "version": 1
    }
