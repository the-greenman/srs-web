  "types": [
    {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "A topic groups problem statements by subject; sections are topical rather than by kind."
      },
      "createdAt": "2026-09-08T14:38:02Z",
      "description": "A topical grouping of problems, nestable under a problem-set or another topic.",
      "fields": [
        {
          "displayLabel": "Title",
          "fieldId": "db580a8d-7662-48ce-bc7f-e50e4a7cccd1",
          "order": 0,
          "required": true
        },
        {
          "displayLabel": "Description",
