          "key": "draft",
          "label": "Draft"
        },
        {
          "description": "Put forward for accountable adoption.",
          "id": "9ffdf9dc-69ca-4d7c-8092-a0f7ba71472b",
          "key": "proposed",
          "label": "Proposed"
        },
        {
          "description": "Adopted as the current project position.",
          "id": "43313258-334a-465a-983e-202c7fda43c0",
          "key": "ratified",
          "label": "Ratified"
        },
        {
          "description": "No longer adopted and has no successor.",
          "id": "36e93740-5112-45fb-9e7a-40e554d25d18",
          "isFinal": true,
          "key": "withdrawn",
          "label": "Withdrawn"
        },
        {
          "description": "Replaced by a ratified successor.",
          "id": "37f75274-760a-4837-b5b2-138b0b3ecdfd",
          "isFinal": true,
          "key": "superseded",
          "label": "Superseded",
          "requiresRelation": {
