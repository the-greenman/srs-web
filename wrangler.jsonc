{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "srs-web",
	"workers_dev": false,
	"preview_urls": true,
	"compatibility_date": "2026-07-06",
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{ "pattern": "app.mudemocracy.org", "custom_domain": true }
	]
}
