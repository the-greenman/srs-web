# Public browser identifiers. Do not add provider client secrets.
VITE_DROPBOX_APP_KEY=
VITE_DROPBOX_REDIRECT_URI=http://localhost:5173/
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
# GitHub App client id (public identifier). The client SECRET is a Worker secret
# (wrangler secret put GITHUB_CLIENT_SECRET) — never a VITE_ value. See README.
# The GitHub App must be PUBLIC (Advanced → Make public): a private app 404s
# the authorize page for every user except the app owner.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/
# GitHub App slug (from the app's URL) — builds the "install/manage" link shown
# in the Save dialog, since a GitHub App must be installed to write.
VITE_GITHUB_APP_SLUG=
