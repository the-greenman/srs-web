# Public browser identifiers. Do not add provider client secrets.
VITE_DROPBOX_APP_KEY=
VITE_DROPBOX_REDIRECT_URI=http://localhost:5173/
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
# GitHub OAuth App client id (public). The client SECRET is a Worker secret
# (wrangler secret put GITHUB_CLIENT_SECRET) — never a VITE_ value. See README.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/
