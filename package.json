{
  "name": "srs-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-bindings.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "fetch-bindings": "node scripts/ensure-bindings.mjs --force",
    "predeploy": "npm run fetch-bindings",
    "deploy": "vite build && wrangler deploy",
    "deploy:preview": "vite build --mode preview && wrangler deploy --env preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^20.10.6",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.100.0"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "@swc/core@1.15.40": true,
    "esbuild@0.25.12": true
  }
}
