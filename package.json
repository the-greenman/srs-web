{
  "name": "srs-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "fetch-bindings": "gh release download --repo the-greenman/srs-rust --pattern 'srs-bindings-web.tar.gz' --dir /tmp --clobber && mkdir -p src/lib/srs_bindings && tar -xzf /tmp/srs-bindings-web.tar.gz -C src/lib/srs_bindings",
    "predeploy": "npm run fetch-bindings",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^20.10.6",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.100.0"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "@swc/core@1.15.40": true,
    "esbuild@0.25.12": true
  }
}
