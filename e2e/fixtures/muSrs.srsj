    "package/themes/guide-prose-4f8a2c1e.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/theme.json",
      "createdAt": "2026-06-05T00:00:00Z",
      "description": "Prose rendering theme for guide document views. Renders visible fields as plain paragraphs — no bold labels. Structural fields (slug, heading, title) are hidden via the paired L1 view.",
      "elementTemplates": {
        "compositeFieldRowTemplates": {
          "item-body": "{{field-value}}\n",
          "item-term": "**{{field-value}}**\n"
        },
        "fieldRow": "{{field-value}}\n"
      },
      "id": "4f8a2c1e-3b7d-4e9f-a1c2-8d5e6f7a9b0c",
      "name": "guide-prose",
      "namespace": "com.mudemocracy",
      "targets": [
        "markdown"
      ],
      "version": 1
    },
    "package/themes/guide-prose-html-5f3d230e.json": {
      "createdAt": "2026-06-08T00:00:00Z",
      "description": "HTML variant of guide-prose for the web preview. Renders visible fields as plain paragraphs without labels. item-term is bolded. Mirrors guide-prose semantics but uses HTML templates.",
      "elementTemplates": {
        "compositeFieldRowTemplates": {
          "item-body": "<p>{{field-value}}</p>",
          "item-term": "<p><strong>{{field-value}}</strong></p>"
        },
        "fieldRow": "<p>{{field-value}}</p>"
      },
      "id": "5f3d230e-850b-417a-ac51-135a81485bc7",
      "name": "guide-prose-html",
      "namespace": "com.mudemocracy",
      "targets": [
        "html"
      ],
      "version": 1
    },
