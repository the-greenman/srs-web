    "packages/essay/relation-types/commudemocracyessaycounters-9eed1245.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/relation-type.json",
      "canonicalDirection": "Source or Claim counters Paragraph",
      "category": "association",
      "createdAt": "2026-10-03T08:58:42.358600456+00:00",
      "description": "Source or claim counters Paragraph (source|claim → paragraph): it argues against what the paragraph says. Essay-local; supporting citations use core evidences instead. Guidance: source = argument source or claim record, target = essay paragraph; use only for genuine opposition to the paragraph's assertion, not mere difference of topic; check existing relations first, relation_create does not reject duplicates.",
      "id": "9eed1245-e4b5-4446-bbb0-c96994cf405a",
      "irreflexive": true,
      "key": "com.mudemocracy.essay/counters",
      "label": "counters",
