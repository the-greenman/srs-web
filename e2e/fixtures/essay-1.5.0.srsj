      "version": 1
    },
    "packages/essay/types/comment-7482e41b.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "A comment is feedback on exactly one paragraph, linked to it by a com.mudemocracy.essay/comments-on relation (comment to paragraph). It never edits the paragraph. Authorship is the engine-stamped createdBy (RFC-046), never a field; the thread order is createdAt."
      },
      "createdAt": "2026-10-02T00:00:00Z",
      "description": "Feedback on exactly one paragraph of an essay.",
