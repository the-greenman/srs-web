    "packages/essay/.srs-import/refs/types/paragraph-ec61d93d.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "One paragraph of an essay. Prose only: no headings or other structural markup in the body; structure comes from paragraph types and the arrangement (entry order and depth in the essay container), not markup. Agents read, title and annotate paragraphs but do not write the writer's prose. To annotate a paragraph, create records and relations, never body edits: `com.mudemocracy.essay/bears-on` (paragraph -> problem it addresses); core `evidences` (source or claim -> paragraph, supports it); `com.mudemocracy.essay/counters` (source or claim -> paragraph, cuts against it); feedback as a `com.mudemocracy.essay/comment` record plus `com.mudemocracy.essay/comments-on` (comment -> paragraph). Created records take no `containerId`. Authorship is the engine-stamped `createdBy`, so no `authored-by`. Never edit the body."
      },
      "createdAt": "2026-10-02T00:00:00Z",
      "description": "One paragraph of an essay: optional gutter title and plain markdown prose.",
      "fields": [
        {
