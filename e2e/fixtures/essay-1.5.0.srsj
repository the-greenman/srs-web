    "packages/essay/.srs-import/refs/fields/bundlecontainerid-ef74b78e.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Editor state only: the containerId of the container whose declared members are everything the essay consists of and refers to (essay record, document-state, paragraphs in the essay, draft and bin containers, comments, and one-hop referenced problems, sources and claims). The editor refreshes it at export and slices it (RFC-026) as the essay's snapshot. Optional; absent until the first snapshot export. Ignored by compositions and renderers."
      },
      "createdAt": "2026-10-04T00:00:00Z",
      "description": "Container bundling everything this essay consists of and refers to.",
      "fieldType": {
        "datatype": "string",
