    "package/fields/bincontainerid-95a4f7ad.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Editor state only: the containerId of the container that holds paragraphs deleted from this essay (the Bin). Deleting a paragraph moves it here, like Drafts; deleting from the Bin is permanent. Optional; absent until the editor first deletes a paragraph. Ignored by compositions and renderers."
      },
      "createdAt": "2026-10-03T00:00:00Z",
      "description": "Container holding paragraphs deleted from this essay (the Bin).",
