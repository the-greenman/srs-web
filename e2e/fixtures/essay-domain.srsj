    "package/relation-types/answers-604145a7.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/relation-type.json",
      "category": "association",
      "createdAt": "2026-09-11T11:47:32.658919832+00:00",
      "description": "Source answers the target problem statement. The source is a remedy where the problem calls for a move a group can make, or a claim where it calls for a position we hold — world-level problems mostly want the second, because there is no move a small group makes about what democracy is taken to mean. A problem with no incoming answers edge is untriaged, not unanswerable; one deliberately left without is terrain.",
      "id": "604145a7-ee65-4586-a1ac-ccefdbccefd8",
      "key": "answers",
      "label": "Answers",
      "namespace": "com.mudemocracy",
      "version": 1
    },
