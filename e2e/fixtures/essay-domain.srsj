    "package/relation-types/commudemocracyessaybears-on-fc8b2665.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/relation-type.json",
      "canonicalDirection": "Paragraph bears on Problem",
      "category": "association",
      "createdAt": "2026-10-03T08:58:42.356397812+00:00",
      "description": "Paragraph bears on Problem (paragraph → problem): the paragraph addresses or is about this problem statement. Essay-local. Guidance: source = essay paragraph, target = argument problem record; use only when the paragraph substantively addresses the problem; check existing relations first, relation_create does not reject duplicates.",
      "id": "fc8b2665-a9e9-4d8f-a4cb-5556982d7121",
      "irreflexive": true,
      "key": "com.mudemocracy.essay/bears-on",
      "label": "bears on",
      "namespace": "com.mudemocracy.essay",
      "version": 1
    },
    "package/relation-types/commudemocracyessaycomments-on-607009b0.json": {
