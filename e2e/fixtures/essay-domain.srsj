    "package/types/comment-7482e41b.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "A comment is feedback on exactly one paragraph, linked to it by a com.mudemocracy.essay/comments-on relation (comment to paragraph). It never edits the paragraph. Create it with containerId = the essay's comments container (document-state comments_container_id), then relate it comments-on (comment to paragraph). Authorship is the engine-stamped createdBy (RFC-046), never a field; the thread order is createdAt. Its label is the start of its text."
      },
      "createdAt": "2026-10-02T00:00:00Z",
      "description": "Feedback on exactly one paragraph of an essay.",
      "fields": [
        {
          "displayLabel": "Body",
          "fieldId": "581e484f-5bc7-4651-a408-0ab53d2711d5",
          "order": 0,
          "required": true
        }
      ],
      "id": "7482e41b-7d3d-4069-b165-ee509dacce22",
      "identityFieldId": "581e484f-5bc7-4651-a408-0ab53d2711d5",
      "name": "comment",
      "namespace": "com.mudemocracy.essay",
      "version": 1
    },
