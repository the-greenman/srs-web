    "package/fields/warrantlevel-ea742151.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "verified, secondary, observed, not-read, recalled, unevidenced or none-required. Record the level actually reached, never the level you wish you had reached — understating costs nothing and overstating is the failure this register exists to catch. Constitutive claims and scope denials take none-required. A claim may not be affirmed until this is set."
      },
      "createdAt": "2026-09-21T15:55:28Z",
      "description": "How far the claim's support was actually checked.",
