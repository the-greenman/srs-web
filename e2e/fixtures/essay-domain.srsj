    "package/fields/commenttext-581e484f.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Plain markdown text of one comment, and the comment's identity (its label is the start of this text). Agents and humans may write comments. Create the comment with containerId = the essay's comments container (document-state comments_container_id), then relation comments-on (comment to paragraph). A comment is feedback on exactly one paragraph and never edits it. Authorship is the engine-stamped createdBy (RFC-046); never write an author here."
      },
      "createdAt": "2026-10-02T21:40:51.924525593+00:00",
      "description": "The text of a comment on one paragraph.",
