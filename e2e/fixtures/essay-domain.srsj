    "package/fields/body-8a16f0d3.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Plain markdown prose of one paragraph: sentences only. Do NOT use structural markup such as headings, lists, tables or horizontal rules; structure comes from paragraph types and the document arrangement (nesting), never from markup in the body. Inline emphasis and links are acceptable. Never write or rewrite the writer's prose unless explicitly asked."
      },
      "createdAt": "2026-10-02T00:00:00Z",
      "description": "The paragraph's prose.",
      "fieldType": {
        "datatype": "string",
        "format": "markdown"
      },
