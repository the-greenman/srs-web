    "package/types/essay-0021ef06.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "The identity record of one essay: its title, optional summary and optional purpose. The essay's container is anchored on this record; the prose lives in paragraph records arranged in that container, never in this record. Purpose is the writer's own and agents never edit it."
      },
      "createdAt": "2026-10-02T00:00:00Z",
      "description": "The document anchor and identity record of one essay in the agent-supported essay editor.",
      "fields": [
