    "packages/essay/types/paragraph-ec61d93d.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "One paragraph of an essay. Prose only: no headings or other structural markup in the body; structure comes from paragraph types and the arrangement (entry order and depth in the essay container), not markup. Agents read, title and annotate paragraphs but do not write the writer's prose. To annotate a paragraph, create records and relations, never body edits: `com.mudemocracy.essay/bears-on` (paragraph -> problem it addresses); core `evidences` (source or claim -> paragraph, supports it); `com.mudemocracy.essay/counters` (source or claim -> paragraph, cuts against it); feedback as a `com.mudemocracy.essay/comment` record plus `com.mudemocracy.essay/comments-on` (comment -> paragraph). Comments go in the essay's comments container. A source, claim or problem you gather for the essay goes in its references container, whether or not you also link it to a paragraph. Authorship is the engine-stamped `createdBy`, so no `authored-by`. Never edit the body."
      },
      "createdAt": "2026-10-02T00:00:00Z",
      "description": "One paragraph of an essay: optional gutter title and plain markdown prose.",
      "fields": [
        {
          "displayLabel": "Title",
          "fieldId": "59b7f51b-3e80-409c-8ee2-b995e1157952",
          "order": 0,
          "required": false
        },
        {
          "displayLabel": "Body",
          "fieldId": "8a16f0d3-0dc8-425a-9616-77dc12c26437",
          "order": 1,
          "required": true
        }
      ],
      "id": "ec61d93d-1cd1-4b52-b231-9f1bfc7b40b6",
      "name": "paragraph",
      "namespace": "com.mudemocracy.essay",
      "version": 1
    },
    "packages/essay/types/problem-6e955608.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "extraction": "Title: give every problem a title, a short noun phrase of about 3 to 8 words naming the problem's core, so a human scanning a list or outline can tell it from its neighbours. Derive it from the record's own statement. Distinct from sibling titles. Examples of the style: \"Training data omits unwritten knowledge\", \"Decisions lost between meetings\". The problem id is a code, not a title; the title does not replace it.",
        "negativeGuidance": "Title must not be the problem id, a truncated or reworded-in-full statement, its first words, or a generic phrase such as \"A problem about decisions\". It must not strengthen or soften what the statement says. Never overwrite a title a person has set.",
        "purpose": "One problem statement extracted from the source material — a claim with its citation id and classifying facets."
      },
      "createdAt": "2026-09-08T14:38:02Z",
      "description": "A single problem statement: a claim, tagged by kind, persona, scale, context and size.",
