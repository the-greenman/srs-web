    "packages/comments/types/comment-11cd0a5f-v2.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "A comment is feedback on exactly one record, linked to it by a com.semanticops.comments/comments-on relation (comment to target). It never edits the target. Create the comment record, then relate it comments-on. Authorship is the engine-stamped createdBy (RFC-046), never a field; thread order is createdAt. Its label is the start of its text. Version 2 adds kind (content and response kinds, ruling ff946eb1) and proposed_relation, which with a proposes-link-to relation carries a link proposal (remedy 2910ac1e). Version 1 comments stay valid."
      },
