    "packages/essay/fields/warrant-cc46971a.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "The grounds: evidence, precedent, reasoning, or an explicit statement that none is needed because the claim is definitional or a refusal. Say plainly where the claim is reasoned rather than evidenced — that is not a weakness, but pretending otherwise is."
      },
      "createdAt": "2026-09-11T12:47:41.289604618+00:00",
      "description": "What entitles us to make this claim.",
      "fieldType": {
        "datatype": "string",
