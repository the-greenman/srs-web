    "packages/essay/types/imageparagraph-34548fd0.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "One image in an essay, as its own paragraph. The image is the record's `attaches` SourceReference to a SourceDocument (PNG, JPEG, WebP or script-free SVG, up to 1 MB); there is no URL field and remote images are not supported. Alt text is required and written by the writer. Layout is full width or original size (left, centre or right); text never wraps. Never put an image in a normal paragraph's markdown. Agents may title and annotate it, as for a paragraph, but do not write alt text or caption."
      },
      "createdAt": "2026-11-09T00:00:00Z",
      "description": "An essay paragraph that shows one attached image, with alt text, an optional caption and a basic layout.",
