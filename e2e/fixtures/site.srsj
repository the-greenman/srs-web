    "packages/essay/vocabularies/persona-fce7c0a8.json": {
      "createdAt": "2026-09-08T14:36:22Z",
      "description": "Where a problem manifests, in muDemocracy's own persona set. This term set is muDemocracy's, not a general taxonomy; an installer adopting this package elsewhere is expected to redefine it via vocabulary term-create, or mark these terms status: deprecated and add their own.",
      "id": "fce7c0a8-e85f-4be0-b7c5-5f16d8fddca3",
      "mode": "closed",
      "name": "persona",
      "namespace": "com.mudemocracy.argument",
      "terms": [
        {
          "description": "The person who keeps the record.",
          "id": "d20aa1a5-91ca-47e3-af0e-5c43c7b905ca",
          "key": "clerk",
          "label": "Clerk",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A member taking part in the process.",
          "id": "bf8b81ba-aaed-442b-bdb8-79538c459c82",
          "key": "participant",
          "label": "Participant",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A founding member shaping the group at its start.",
          "id": "3287ecce-e5ec-41f4-beb4-c8ee96b93fc6",
          "key": "founder",
          "label": "Founder",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A property of the collective that no single member encounters alone; not 'unclassified'.",
          "id": "ffc65580-6050-4f80-b573-1f301bee58b1",
          "key": "group",
          "label": "Group",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A member of the wider constituency the group answers to.",
          "id": "2bb479b0-1d73-4b00-88ff-d4afc48f77ef",
          "key": "constituent",
          "label": "Constituent",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        }
      ],
      "version": 1
    },
    "packages/essay/vocabularies/problem-kind-0422ac58.json": {
      "createdAt": "2026-09-08T14:36:22Z",
      "description": "What sort of thing a problem statement is: a belief people hold, a capability that is missing, a condition of the world, a consequence that follows, or a shift already underway.",
      "id": "0422ac58-71d1-4308-9a07-5448806e098b",
      "mode": "closed",
      "name": "problem-kind",
      "namespace": "com.mudemocracy.argument",
      "terms": [
        {
          "description": "A belief people hold, e.g. that democracy means voting.",
          "id": "88d92dbd-363f-4001-a409-c45f30991118",
          "key": "belief",
          "label": "Belief",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A capability that is missing or undeveloped.",
          "id": "92d84e42-1157-466c-8f7f-ebd78e0494c2",
          "key": "capability",
          "label": "Capability",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A condition of the world, not an experience anyone has directly.",
          "id": "5c9ef07a-c048-431b-af77-65bcb4d29e7b",
          "key": "condition",
          "label": "Condition",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A consequence that follows from some other condition or belief.",
          "id": "8eeb60ca-52d1-406e-81d2-f257f3c6ba15",
          "key": "consequence",
          "label": "Consequence",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A shift already underway that changes the terrain.",
          "id": "cc038a63-1224-4220-91ec-88c1e51666f6",
          "key": "shift",
          "label": "Shift",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        }
      ],
      "version": 1
    },
    "packages/essay/vocabularies/scale-201bb8fb.json": {
      "createdAt": "2026-09-08T14:36:22Z",
      "description": "Where the problem lives: added because persona would not fill for statements whose subject is a condition of the world rather than an experience someone has, e.g. nobody in a housing co-operative meets concentration of the AI stack; they live inside its consequences.",
      "id": "201bb8fb-ed4f-4753-808e-974fe08a2aab",
      "mode": "closed",
      "name": "scale",
      "namespace": "com.mudemocracy.argument",
      "terms": [
        {
          "description": "The problem lives at the scale of a single group (default, usually unstated).",
          "id": "876bb1d8-bf71-4d4d-a4e7-18b128b6fade",
          "key": "group",
          "label": "Group",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "The problem lives at the scale of society at large.",
          "id": "2e0ecd48-c31c-4ec1-985f-bb2e0076fa19",
          "key": "society",
          "label": "Society",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        }
      ],
      "version": 1
    },
    "packages/essay/vocabularies/source-kind-62de1a6e-v2.json": {
      "createdAt": "2026-09-08T14:36:22Z",
      "description": "What kind of source material a problem statement or evidence record was drawn from. Open because new kinds of source material will keep turning up.",
      "id": "62de1a6e-3524-449a-ae9c-399768a598cb",
      "mode": "closed",
      "name": "source-kind",
      "namespace": "com.mudemocracy.argument",
      "terms": [
        {
          "description": "Handwritten cards, photographed.",
          "id": "51dcef81-ceb2-44b9-9045-bc367978adbd",
          "key": "cards",
          "label": "Cards",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A dictated account.",
          "id": "e2281c3c-ab99-4a7d-aa10-fcb45865d5d1",
          "key": "dictation",
          "label": "Dictation",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A recorded conversation.",
          "id": "59d4689a-2d02-4762-8368-cab776a224d6",
          "key": "conversation",
          "label": "Conversation",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A written essay or article.",
          "id": "ff06e6b1-9899-41eb-a4b1-42700bca7f67",
          "key": "essay",
          "label": "Essay",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A research or reference document.",
          "id": "4d2518b1-6449-4459-a7d0-f5055940fc96",
          "key": "document",
          "label": "Document",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A transcript of spoken material.",
          "id": "069fe35d-6883-489a-a9ff-c29135a7244c",
          "key": "transcript",
          "label": "Transcript",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "createdAt": "2026-09-11T12:19:32.117285433+00:00",
          "description": "An account from someone practising a remedy in a real group. The channel through which remedies are evidenced or challenged.",
          "id": "8dbfa8e5-6b2e-4a5b-a631-3a31b6ce8fb3",
          "key": "report",
          "label": "Report from use",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "createdAt": "2026-09-11T12:19:32.127139145+00:00",
          "description": "A published book or standing body of written practice.",
          "id": "02038dc0-9b7e-4eeb-8f32-c8ffccaf1f1c",
          "key": "book",
          "label": "Book",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "createdAt": "2026-09-11T12:19:32.137915419+00:00",
          "description": "A page or document published online and cited by URL.",
          "id": "da99c49a-f16f-4002-885a-9e38cc3d0d68",
          "key": "web",
          "label": "Web",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        },
        {
          "description": "A dataset or data table the project calculated from. Its level is computed: as strong as the dataset and the method, no stronger.",
          "id": "52d67dc6-c18c-485f-b4b5-311a734905dc",
          "key": "dataset",
          "label": "Dataset",
          "namespace": "com.mudemocracy.argument",
          "version": 1
        }
      ],
      "version": 2
    },
    "packages/essay/vocabularies/warrant-level-cf5ca321-v2.json": {
      "createdAt": "2026-09-21T15:55:28Z",
      "description": "At what level the support recorded in a claim's warrant was actually reached. The maintainer's rule is that the warrant says what supports the claim AND how far that support was checked; this makes that second part selectable rather than a word buried in prose. It is a statement about the CHECKING, not about how strong the claim is. On a source record it says how far that work has been read; on a quotation, how far those words were checked.",
      "id": "cf5ca321-e084-406e-851e-2f76809825f3",
      "mode": "closed",
      "name": "warrant-level",
      "namespace": "com.mudemocracy",
      "terms": [
        {
          "description": "Checked against the source at the level the warrant states. This is the strongest level the corpus claims and it does not imply the primary full text was reached unless the warrant says so.",
          "id": "18e06e00-25d2-45c4-a52d-3d3a0553cbcc",
          "key": "verified",
          "label": "Verified",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "Checked, but at abstract, review or secondary level. The primary text was not reached, so wording and figures carry the secondary source's authority rather than the original's.",
          "id": "0e6ffd0b-ea49-48c5-b989-87239dadd6f9",
          "key": "secondary",
          "label": "Secondary",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "Description of a present practice that anyone could confirm by watching. Admissible without literature, because a practice a few years old has none. It licenses no claim about what the practice CAUSES: that is a prediction and needs its own warrant.",
          "id": "0ba5ea2d-5c35-4929-aec8-ea75938612e1",
          "key": "observed",
          "label": "Observed",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "Our own calculation from a named dataset, reproducible from that dataset and the method recorded with it. As strong as the dataset and the method, and no stronger: the dataset's own coding choices carry through.",
          "id": "c0907790-95af-44c0-97ee-9c0a7f7b5201",
          "key": "computed",
          "label": "Computed",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "Taken from an encyclopedia or wiki page. The figure is probably right but has not been traced to the original count; a tertiary figure that carries an argument is a retrieval job.",
          "id": "df9bb197-8ed6-4b16-95e3-b2ec0697c716",
          "key": "tertiary",
          "label": "Tertiary",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "A source is named and cited but its text was not reached. Page, wording and figures are unconfirmed. A load-bearing claim at this level is a retrieval job, not a finished claim.",
          "id": "7f9f9451-90b6-41b9-bf61-33c98b3bad3a",
          "key": "not-read",
          "label": "Not read",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "Stated from general knowledge and not checked against anything on the record. The weakest level that still asserts something about the world.",
          "id": "246606fc-9481-449f-bdb0-fd51d04b371c",
          "key": "recalled",
          "label": "Recalled",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "No evidence is offered and none is claimed. Saying so plainly is what makes the claim admissible; a claim that reads confidently and cites nothing is the failure mode this register exists to prevent.",
          "id": "feadbf72-04bd-4547-9faa-16d4725c115d",
          "key": "unevidenced",
          "label": "Unevidenced",
          "namespace": "com.mudemocracy",
          "version": 1
        },
        {
          "description": "The kind carries no evidential obligation. Constitutive claims and scope denials are not supported by evidence and are not weakened by its absence.",
          "id": "45c4be68-5058-4bf7-a2c4-cb2a4f3c4bf4",
          "key": "none-required",
          "label": "None required",
          "namespace": "com.mudemocracy",
          "version": 1
        }
      ],
      "version": 2
    },
    "packages/website/blueprints/homepage-3c9069fa.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/blueprint.json",
      "aiGuidance": {
        "purpose": "Create an argument-led homepage as an ordered composition. Require a hero and a final CTA, treat middle blocks as optional, and ensure the order carries the reader from concern to proof to immediate action. Do NOT author contains Relations between a page and its blocks (a group block DOES contain its items: a feature group contains its feature cards and a decision record contains its items, ordered among themselves by precedes): blocks are shared across page variants by Container membership, and order lives in the Composition. Use projects Relations to make every substantive block reviewable against the SRS records it stands on. A hero and a final CTA are REQUIRED in every homepage variant. That requirement cannot currently be declared structurally: Blueprint.requiredTypes is validated against relation structure, and this document has none by design, so the requirement is stated here and enforced by review."
      },
      "createdAt": "2026-09-14T17:08:39.806335947+00:00",
      "description": "A compositional homepage. Block membership and page order are presentational and are declared by a Container whose ordered entries carry the page order (RFC-043), not by contains Relations (a group block contains its own items): page structure at this level is presentation, not a part-of claim about the world (RFC-034 I-148 — a Container is a declared selection, a Relation is a semantic claim).",
      "id": "3c9069fa-5804-40a9-9010-c0713b339619",
      "name": "homepage",
      "namespace": "com.mudemocracy.website",
      "requiredTypes": [
        {
          "typeId": "704c2742-9b02-4d08-89c5-7fa1ffa85697",
          "typeVersion": 1
        },
        {
          "typeId": "3751bf69-e00f-4e77-bbb2-fb7e3d3dfcf7",
          "typeVersion": 1
        }
      ],
      "rootTypes": [
        {
          "typeId": "5de26162-3fd5-4fc9-b32e-567db46bb552",
          "typeVersion": 1
        }
      ],
      "structure": [
        {
          "cardinality": "one-to-one",
          "relationType": "precedes",
          "required": true,
          "sourceType": {
            "typeId": "704c2742-9b02-4d08-89c5-7fa1ffa85697",
            "typeVersion": 1
          },
          "targetType": {
            "typeId": "03de48d7-f3b5-45da-89c7-7718e4e80d58",
            "typeVersion": 1
          }
        },
