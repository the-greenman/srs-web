    "package/relation-types/challenges-e3ccd8f7.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/relation-type.json",
      "category": "evidence",
      "createdAt": "2026-09-11T12:19:32.106937169+00:00",
      "description": "Source challenges the target claim: evidence that it does not hold, or does not hold in this case. Deliberately weaker than refutation — a single report challenges, and challenges accumulate; withdrawing or revising the claim stays a human judgement made through supersedes.",
      "id": "e3ccd8f7-a26b-4b3f-955e-bcc4ceb98e4f",
      "key": "challenges",
      "label": "Challenges",
      "namespace": "com.mudemocracy",
      "version": 1
    },
    "package/relation-types/uses-ce533644.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/relation-type.json",
      "category": "association",
      "createdAt": "2026-09-11T12:32:07.051932227+00:00",
      "description": "Source includes the target canonical text by reference rather than copying it. The canonical text is edited in one place and every user follows; a canonical text with incoming uses edges is in service and must be updated rather than superseded.",
      "id": "ce533644-9514-40bb-aa39-8cc5ae3d2007",
      "key": "uses",
      "label": "Uses",
      "namespace": "com.mudemocracy",
      "version": 1
    },
    "package/types/claim-d6224314.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "extraction": "Title: give every claim a title, a short noun phrase of about 3 to 8 words naming a claim's thesis, so a human scanning a list or outline can tell it from its neighbours. Derive it from the record's own statement. Distinct from sibling titles. Examples of the style: Pillars of the argument: \"Decisions need a durable record\", \"Small groups can hold decisions\". The claim id is a code, not a title; the title does not replace it.",
        "negativeGuidance": "Title must not be the claim id, a truncated or reworded-in-full statement, its first words, or a generic phrase such as \"A claim about decisions\". It must not strengthen or soften what the statement says. Never overwrite a title a person has set.",
        "purpose": "One claim the project makes. Claims are the argument layer and are INTERNAL — they are never rendered into public material. A problem statement records what is the case; a claim records what we assert about it, and names the stronger version it refuses to make so that public copy can be audited against it. A claim is where work starts. If a claim's wording later has to be reused consistently across outputs it earns a canonical-text, which derives from it; the claim itself does not become the text. Claims are drafted, never inherited: a claim taken from an earlier document stays in draft until it has been re-examined and affirmed on its own merits. Earlier project documents are sources, not authority."
      },
      "createdAt": "2026-09-11T12:47:41.422574265+00:00",
      "description": "Fixture claim: claim_id, title and warrant_level only.",
      "fields": [
        {
          "displayLabel": "Claim ID",
          "fieldId": "3ab45ec6-50d5-43dc-a5bb-f68d13b33a91",
          "order": 0,
          "required": true
        },
        {
          "displayLabel": "Warrant level",
          "fieldId": "ea742151-a85e-42a7-b6e2-38e293716407",
          "order": 6,
          "required": false
        },
        {
          "displayLabel": "Title",
          "fieldId": "db580a8d-7662-48ce-bc7f-e50e4a7cccd1",
          "order": 7,
          "required": false
        }
      ],
      "id": "d6224314-331d-4321-b819-9a52d35dc029",
      "identityFieldId": "db580a8d-7662-48ce-bc7f-e50e4a7cccd1",
      "name": "claim",
      "namespace": "com.mudemocracy",
      "version": 1
    },
