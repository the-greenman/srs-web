    "packages/essay/fields/locator-daa5c5c6.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Page, chapter, section, paragraph or timestamp — enough for a reader to turn to it. Give it only at the level actually checked and do not invent page, chapter or paragraph numbers; 'ch. 2' from a reflowable ebook with no page anchors is honest, an invented 'p. 47' is not. Where an edition matters to the number, name the edition here too."
      },
      "createdAt": "2026-09-21T16:42:31Z",
      "description": "Where in the source the passage is found.",
