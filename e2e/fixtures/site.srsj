    "packages/essay/relation-types/commudemocracyessaycounters-9eed1245.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/relation-type.json",
      "canonicalDirection": "Source counters Paragraph",
      "category": "association",
      "createdAt": "2026-10-03T08:58:42.358600456+00:00",
      "description": "Source counters Paragraph (source → paragraph): it argues against what the paragraph says. Essay-local; supporting citations use core evidences instead. Guidance: source = a source or quotation record, target = essay paragraph; use only for genuine opposition to the paragraph's assertion, not mere difference of topic; check existing relations first, relation_create does not reject duplicates.",
      "id": "9eed1245-e4b5-4446-bbb0-c96994cf405a",
      "irreflexive": true,
      "key": "com.mudemocracy.essay/counters",
      "label": "counters",
      "namespace": "com.mudemocracy.essay",
      "version": 1
    },
    "packages/essay/types/comment-7482e41b.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "purpose": "Deprecated since essay 1.8.0: write com.semanticops.comments/comment (fields comment_text, kind) and com.semanticops.comments/comments-on instead; this definition is kept only so existing essay comments stay valid. A comment is feedback on exactly one paragraph, linked to it by a com.mudemocracy.essay/comments-on relation (comment to paragraph). It never edits the paragraph. Create it with containerId = the essay's comments container (document-state comments_container_id), then relate it comments-on (comment to paragraph). Authorship is the engine-stamped createdBy (RFC-046), never a field; the thread order is createdAt. Its label is the start of its text."
      },
      "createdAt": "2026-10-02T00:00:00Z",
      "description": "Feedback on exactly one paragraph of an essay.",
      "fields": [
