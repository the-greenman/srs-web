    "records/tier-2/decision-3be7b057.json": {
      "createdAt": "2026-02-20T14:00:00.000Z",
      "fieldValues": {
        "decision_statement": "Centre of all works at 165cm from floor. Standard for all installations unless the curatorial lead specifies otherwise for a particular show.",
        "external_links": [
          "https://example.org/minutes/2026-02-20",
          "https://limehouse.org/policy-docs"
        ],
        "rationale": "Establishes a consistent baseline that removes ad-hoc judgement from each installation. Curatorial override preserved where needed.",
        "status": "active",
        "title": "Eye level standard"
      },
      "instanceId": "3be7b057-9167-42a4-b0db-2a8b30666cef",
      "tags": [
        "exhibitions"
      ],
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.210871569+00:00"
    },
    "records/tier-2/decision-4a989562.json": {
      "createdAt": "2026-03-25T16:45:00.000Z",
      "fieldValues": {
        "alternatives_considered": "Including the main hallway in Phase 1. Deferred to Phase 2.",
        "context": "The back stairs have a large amount of wall space across multiple landings. The main hallway was also discussed as a potential exhibition space, but adding it in Phase 1 would significantly increase the scope of the first experiment.",
        "decision_question": "Should Phase 1 cover the full stairwell including the main hallway, or just the back stairs and landings?",
        "decision_statement": "Phase 1 covers the back stairs and landings only. The main hallway is explicitly deferred to Phase 2, contingent on Phase 1 working well.",
        "friction": "Taking on too much in Phase 1 risks overextending the group's capacity before the mounting system and workflow have been tested.",
        "rationale": "Starting smaller allows the group to test the mounting system, workflow, and artist relations before expanding. The main hallway is more visible and involves more parties.",
        "revisit_when": "December 2026 pilot review — if Phase 1 is working, bring main hallway into scope for Phase 2.",
        "status": "active",
        "title": "Phase 1 scope"
      },
      "instanceId": "4a989562-4a9d-4c86-a365-91bf14d55f06",
      "tags": [
        "governance"
      ],
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.216707675+00:00"
    },
    "records/tier-2/decision-5ec00003.json": {
      "createdAt": "2026-07-09T00:00:00Z",
      "fieldValues": {
        "decision_statement": "Section header for the decision log of this document.",
        "status": "active",
        "title": "Decision Log"
      },
      "instanceId": "5ec00003-0000-4000-8000-000000000003",
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-07-09T00:00:00Z"
    },
    "records/tier-2/decision-9054911c.json": {
      "createdAt": "2026-01-15T10:00:00.000Z",
      "fieldValues": {
        "alternatives_considered": "Open-ended pilot with no fixed review date — judged too likely to drift.",
        "decision_statement": "Six-month pilot, June to December 2026. At the end of that period the group meets to decide what comes next: continue, extend, change scope, or close.",
        "rationale": "A defined lifespan makes the review real rather than optional. Open-ended pilots drift without a moment of explicit recommitment.",
        "revisit_when": "December 2026. The review meeting produces a new decision that either supersedes this one or records closure.",
        "status": "active",
        "title": "Pilot duration and review"
      },
      "instanceId": "9054911c-5285-4c3e-8198-4b9650169001",
      "tags": [
        "operations"
      ],
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.204282404+00:00"
    },
    "records/tier-2/decision-9af57e54.json": {
      "createdAt": "2026-03-11T11:00:00.000Z",
      "fieldValues": {
        "context": "The back stairwell cannot be locked — it is also a fire escape route. There is no practical mechanism to insure or protect work against theft or accidental damage in an open-access space.",
        "decision_statement": "Artists retain ownership of and responsibility for their own work. The project does not insure exhibited work. Artists are informed of this before agreeing to show.",
        "rationale": "Artists must make their own insurance decisions. The project is not in a position to take on liability for others' work and is not a commercial operation. Informing artists upfront keeps the arrangement honest.",
        "status": "active",
        "title": "Artist liability"
      },
      "instanceId": "9af57e54-03fb-4625-9a4c-8d2a254ff2b7",
      "tags": [
        "operations"
      ],
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.213600816+00:00"
    },
    "records/tier-2/decision-a9ca11cf.json": {
      "createdAt": "2026-05-01T13:30:00.000Z",
      "fieldValues": {
        "context": "The founding meeting discussed the importance of being honest with artists about what happens if the project ends. Article A-006 states the constitutional commitment; this decision makes it operational and specific.",
        "decision_question": "What specific obligations do we commit to if and when the project closes?",
        "decision_statement": "On closure the group commits to: (1) returning all artworks to their makers within 14 days of the closure decision; (2) making good all fixings and mounts within 28 days; (3) settling any outstanding commitments to artists before disbanding; (4) transferring any remaining group funds to the Party Utility. The Clerk records when each obligation is discharged.",
        "rationale": "Specific timelines make the commitment real. Without them, 'we will return work' is a statement of intent that can drift indefinitely.",
        "status": "active",
        "title": "Closure obligations"
      },
      "instanceId": "a9ca11cf-fd34-4901-b5f6-51e20737cb56",
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.221996502+00:00"
    },
    "records/tier-2/decision-dd715d4a.json": {
      "createdAt": "2026-04-08T09:00:00.000Z",
      "fieldValues": {
        "context": "The group agreed that a single named person should lead curatorial decisions during Phase 1 to avoid decisions-by-committee on what is shown. The role was discussed as a practical necessity to get the first show up.",
        "decision_question": "Who will take the curatorial lead role for Phase 1, selecting and placing the work?",
        "decision_statement": "Immo Klink is the curatorial lead for Phase 1. Immo has authority to select which works are shown and to decide their placement in the space, subject to Building Authority approval of any installation method.",
        "rationale": "Immo is the most experienced exhibitor in the group and is providing the first show's work. Having a single decision-maker for curation avoids gridlock and makes the show happen.",
        "revisit_when": "December 2026 pilot review. The role may be rotated, shared, or redefined for Phase 2.",
        "status": "active",
        "title": "Curatorial lead for Phase 1"
      },
      "instanceId": "dd715d4a-8640-4641-b79d-e44f728c547b",
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.219219114+00:00"
    },
    "records/tier-2/decision-eb4024a0.json": {
      "createdAt": "2026-02-03T09:30:00.000Z",
      "fieldValues": {
        "alternatives_considered": "Hanging rails — inflexible, institutional-looking, poor fit for the angles in this stairwell. Command strips — fail on these walls, require grease-free surface, come off after about a week. Bolt systems — overkill for the weights involved. Sacrificial backing boards — interesting but adds complexity; may revisit for Phase 2. Central suspension from ceiling/beam — technically interesting but complex to engineer safely.",
        "context": "The stairwell is an old building with plaster walls. The group had already been hanging art informally using various ad-hoc methods. A six-month pilot gallery experiment was being planned, requiring a repeatable and durable solution. The building is a shared cooperative space, so any approach must protect the walls and be acceptable to the wider building.",
        "decision_question": "Should we install permanent fixings in the stairwell walls, or use a removable or flexible mounting approach for each show?",
        "decision_statement": "Permanent 6mm wall plugs (brown equivalent) with screws, drilled once and left in place. Typically two screws per position. Caps or covers fabricated for unused fixings between shows.",
        "friction": "The walls crumble when repeatedly drilled — every new hole degrades the plaster further. There is currently no consistent hanging system, so each person uses whatever is to hand (blue tack, tape, random screws), which looks poor and provides no standard for the pilot gallery. Something needs to be installed once and reused across shows.",
        "key_requirements": "Must not continuously damage old plaster walls (non-negotiable). Must accommodate different artwork sizes, weights, and formats across multiple shows. Must look intentional — not like a DIY bodge — when fixings are not in use. Must be simple enough to install correctly the first time. Should protect the building, which is a shared cooperative space. Aesthetics vs practicality was the main tension discussed: the group accepted a slightly visible fixing system in exchange for durability and flexibility.",
        "next_steps": "Brian to sketch mounting ideas and share with the group. Trial 6mm plugs in back stairwell as Phase 1 experiment. Fabricate decorative caps for unused fixings between shows. Phase 2 approach for main hallway to be decided separately.",
        "rationale": "Repeated drilling degrades these walls faster than permanent fixings. Once drilled correctly, the plug can be reused indefinitely. Keeping a cap on unused fixings means the system looks intentional between shows rather than abandoned.",
        "revisit_when": "Wall condition deteriorates significantly, or Phase 2 requires a different approach for the main hallway.",
        "status": "active",
        "title": "Mounting system"
      },
      "instanceId": "eb4024a0-486f-4d64-a4e4-5d80297129d2",
      "tags": [
        "exhibitions"
      ],
      "typeId": "1fcad6a2-9f78-5e41-94ba-d82e88b822f3",
      "typeName": "decision",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.208195703+00:00"
    },
    "records/tier-2/exercise-5ec00004.json": {
      "createdAt": "2026-07-09T00:00:00Z",
      "fieldValues": {
        "title": "Exercises"
      },
      "instanceId": "5ec00004-0000-4000-8000-000000000004",
      "typeId": "7f73b83e-4a5b-4c6d-8e9f-1a2b3c4d5e6f",
      "typeName": "exercise",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-07-09T00:00:00Z"
    },
    "records/tier-2/exercise-ee000001.json": {
      "createdAt": "2026-06-27T00:00:00Z",
      "fieldValues": {
        "blocking": "Agreement on Phase 2 scope is needed before we can plan the next exhibition cycle.",
        "next_action": "Clerk to circulate a Phase 2 proposal for comment by the end of July. All members to respond within two weeks.",
        "tensions": "Some members feel the decision-making process is slow. Others feel it is appropriately thorough for a shared space. There is tension between speed and careful deliberation.",
        "thinking_reached": "The group has reached a shared understanding that the pilot has demonstrated the space works for small group exhibitions. The hanging system is effective and the rotation schedule is sustainable.",
        "title": "Pilot phase retrospective",
        "unresolved_questions": "What is the right frequency for exhibition rotation? Should we formalise the curatorial process for Phase 2?"
      },
      "instanceId": "ee000001-0000-4000-8000-000000000001",
      "lifecycleState": "ratified",
      "typeId": "7f73b83e-4a5b-4c6d-8e9f-1a2b3c4d5e6f",
      "typeName": "exercise",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-06-27T00:00:00Z"
    },
    "records/tier-2/exercise-ee000002.json": {
      "createdAt": "2026-06-27T00:00:00Z",
      "fieldValues": {
        "blocking": "None — the group can proceed on a provisional basis while the threshold question is worked out.",
        "next_action": "Building Authority to draft a proposed spending threshold for the next meeting.",
        "tensions": "The group is divided on what counts as 'minor'. One member feels any decision on spending should require full attendance.",
        "thinking_reached": "The group agrees that minor operational decisions can proceed with those present. Decisions that affect the constitutional articles or roles should wait for full attendance or use an asynchronous written consent process.",
        "title": "How do we make decisions when someone is absent?",
        "unresolved_questions": "Where exactly is the threshold between operational and constitutional decisions? Should there be a spending threshold?"
      },
      "instanceId": "ee000002-0000-4000-8000-000000000002",
      "lifecycleState": "ratified",
      "typeId": "7f73b83e-4a5b-4c6d-8e9f-1a2b3c4d5e6f",
      "typeName": "exercise",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-06-27T00:00:00Z"
    },
    "records/tier-2/role-448d64d4.json": {
      "createdAt": "2026-05-31T14:55:35.200802911+00:00",
      "fieldValues": {
        "authority": "May write up and maintain the decision log, Articles, and role records. May flag when a proposed action appears inconsistent with a recorded decision or article. Responsible for ensuring that Article A-006 (On ending) obligations are discharged when the time comes.",
        "boundary": "Cannot decide what is shown or how it is installed. The Clerk's role is to maintain the record faithfully — not to determine its content. Cannot amend a decision unilaterally; can only record what the group has agreed.",
        "role_holder": "Peter Brownell",
        "source_of_authority": "Established by Article A-004 (How we make decisions).",
        "status": "active",
        "title": "R-003 Clerk"
      },
      "instanceId": "448d64d4-ae82-4971-b027-3b78b9c7a90a",
      "typeId": "e53dce11-6b83-5714-a8fe-f730edb500fa",
      "typeName": "role",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.200804860+00:00"
    },
    "records/tier-2/role-5bbf9209.json": {
      "createdAt": "2026-05-31T14:55:35.195104906+00:00",
      "fieldValues": {
        "authority": "May decide what fixings and mounting methods are acceptable for the physical fabric of the building. May halt or reverse installation work that risks damage to walls, plaster, or structural elements. Has final say on whether a proposed intervention is safe and appropriate.",
        "boundary": "Cannot decide what artwork is shown or how it is curated — that is the Curatorial Lead's authority. Cannot commit the group to structural changes without Party Utility agreement. Cannot override A-005 (Care of the building).",
        "role_holder": "Sam Hayder",
        "source_of_authority": "Inherited from the Party Utility, who granted access to the back stairs and entrusted Sam with responsibility for the physical space.",
        "status": "active",
        "title": "R-001 Building Authority"
      },
      "instanceId": "5bbf9209-1dc9-44b2-b0a3-f2192db5a879",
      "typeId": "e53dce11-6b83-5714-a8fe-f730edb500fa",
      "typeName": "role",
      "typeNamespace": "governance",
      "typeVersion": 1,
      "updatedAt": "2026-05-31T14:55:35.195106870+00:00"
    },
    "records/tier-2/role-5ec00002.json": {
