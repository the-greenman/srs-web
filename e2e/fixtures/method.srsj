    },
    "package/fields/lookslike-d2f41e5b.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "One plain-English sentence in the third person (a team, a person, a document); rewrite first-person source text.",
        "negativeGuidance": "Do not use first person, mystical or elemental terms, or praise the side over its opposite; both sides are legitimate.",
        "purpose": "What it looks like in practice to lean on this side (public word: side; the record is a pole)."
      },
      "createdAt": "2026-10-08T11:04:36.936Z",
      "description": "What holding one side of a trade-off looks like.",
