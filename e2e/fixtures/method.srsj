        "format": "plain"
      },
      "id": "812204a1-484b-4120-bad0-a4503dab8a8a",
      "name": "goals",
      "namespace": "com.semanticops.method",
      "version": 1
    },
    "package/fields/imbalance-191eb505.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "Pick the one term that describes the imbalance against the concerned side.",
        "negativeGuidance": "Do not invent values.",
