    "package/fields/kind-50b17985.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "Pick the one term that best matches the statement; a consequence follows from other problems, a shift is a change in the world.",
        "negativeGuidance": "Do not invent values; the domain is closed.",
        "purpose": "Classifies a problem as belief, capability, condition, consequence or shift. Aligned with muSrs argument/kind."
      },
      "createdAt": "2026-10-08T10:44:21.280501565+00:00",
