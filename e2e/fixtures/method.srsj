    "package/fields/goals-812204a1.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "Three to five short phrases in the persona's own terms, one per entry.",
        "negativeGuidance": "Do not list features, products or solutions.",
        "purpose": "The outcomes this persona wants in this domain, as short phrases. Jobs are the tasks done to reach them; goals are why. Problems are held when goals are blocked."
      },
      "createdAt": "2026-10-11T18:00:00+00:00",
      "description": "What a persona, in one domain, is trying to achieve.",
      "editorHint": "singleline",
      "fieldType": {
        "cardinality": "list",
