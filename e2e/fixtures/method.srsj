      "aiGuidance": {
        "extraction": "One short sentence.",
        "negativeGuidance": "Not the boundary clause; that is the reverse case.",
        "purpose": "The situation in which the principle's default (public word: default) is meant to be applied."
      },
      "createdAt": "2026-10-08T11:04:37.131Z",
      "description": "Where a principle's leaning applies.",
