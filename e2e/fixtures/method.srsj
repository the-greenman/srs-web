    "package/fields/statement-159222a6.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "State the problem, not the fix. Keep it falsifiable and specific to who is affected.",
        "negativeGuidance": "Do not include the remedy, facet labels or a persona name as prose; the persona is a held-by relation.",
        "purpose": "For a problem: the claim itself, one sentence or short paragraph, from the persona's point of view. For a principle: the default in 'X over Y' form (public word: default)."
      },
      "createdAt": "2026-10-08T10:44:21.215446825+00:00",
      "description": "The claim a record makes: a problem's claim or a principle's default.",
