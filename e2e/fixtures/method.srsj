      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "One short paragraph naming the common thread.",
        "negativeGuidance": "Do not list the member problems; they are linked by contains relations.",
        "purpose": "Names the theme that binds a cluster's problems, so a reader can judge membership."
      },
