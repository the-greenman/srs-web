    "package/types/tension-91bd6f8a.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "extraction": "Title names the pair ('Action: Act / Observe'); description says what is being traded.",
        "negativeGuidance": "Never rank one pole as the wrong one. Do not store the poles in a text field; they are pole records.",
        "purpose": "Public word: trade-off. A tension contains exactly two poles (core contains), both legitimate; health is movement between them, failure is collapse onto one."
