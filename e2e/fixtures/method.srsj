    "package/fields/actorid-94d587e4.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "Exactly the id string, 'agent:<name>'.",
        "negativeGuidance": "No spaces; do not reuse another agent's id.",
        "purpose": "The stable SRS_ACTOR id (for example agent:watcher) so a suggestion's createdBy traces to this agent record."
      },
      "createdAt": "2026-10-08T11:04:37.313Z",
      "description": "The session actor id an agent runs with.",
