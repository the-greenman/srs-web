    "packages/comments/fields/commenttext-d34c8983.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Plain markdown text of one comment, and the comment identity (its label is the start of this text). Humans and agents may write comments. Create the comment as a record, then relate it comments-on (comment to the record it addresses). A comment never edits its target. Authorship is the engine-stamped createdBy (RFC-046); never write an author here."
      },
      "createdAt": "2026-10-08T15:16:01.308941412+00:00",
      "description": "The text of a comment on a record.",
      "editorHint": "textarea",
      "fieldType": {
        "cardinality": "single",
        "datatype": "string",
        "format": "markdown"
      },
      "id": "d34c8983-3b82-49b0-ac59-acd7ead5180a",
      "name": "comment_text",
      "namespace": "com.semanticops.comments",
      "version": 1
    },
    "packages/comments/fields/kind-fc28c45f.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Content kinds (question, objection, evidence, suggestion, task) comment on a record that is not a comment. Response kinds (agree, disagree, done, rejected, withdrawn) comment on the comment they answer, and only response kinds may target a comment (ruling ff946eb1). agree and disagree are a writer's verdict (the thumbs); done and rejected settle a task, with the text as the reason; withdrawn clears the author's verdict or reopens the task. The current verdict or task state is the latest response by that author; changing one's mind is a new response, never an edit or a deletion. Read the responses before commenting again, and never propose a rejected task again. Optional: a comment with no kind is a plain comment."
      },
      "createdAt": "2026-10-28T00:00:00Z",
      "description": "What kind of comment this is: a content kind, or a response kind that answers another comment.",
      "fieldType": {
        "allowedValues": [
          "question",
          "objection",
          "evidence",
          "suggestion",
          "task",
          "agree",
          "disagree",
          "done",
          "rejected",
          "withdrawn"
        ],
        "cardinality": "single",
        "datatype": "string",
        "valueDomain": "closed"
      },
      "id": "fc28c45f-ecf2-4ded-b152-f9cbf93074c4",
      "name": "kind",
      "namespace": "com.semanticops.comments",
      "version": 1
    },
    "packages/comments/fields/proposedrelation-9aabee0d.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "purpose": "Set only on a suggestion comment that proposes a link: the installed relation-type key (for example com.semanticops.method/answers) of the link from the commented record to the record the comment proposes-link-to. The link itself is not written until it is affirmed: a relation is a claim and has no suggested state (remedy 2910ac1e). The owner answers with an agree or disagree response."
      },
      "createdAt": "2026-10-28T00:00:00Z",
      "description": "The relation-type key of the link a suggestion comment proposes.",
      "fieldType": {
        "cardinality": "single",
        "datatype": "string"
      },
      "id": "9aabee0d-c0a7-470a-b72d-a49bfe5e7964",
      "name": "proposed_relation",
      "namespace": "com.semanticops.comments",
      "version": 1
    },
