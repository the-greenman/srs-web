      "aiGuidance": {
        "extraction": "One line, role only.",
        "negativeGuidance": "No private content, no run rules.",
        "purpose": "The agent's role in one line."
      },
      "createdAt": "2026-10-08T11:04:37.433Z",
      "description": "One-line description of an agent's job.",
      "editorHint": "textarea",
