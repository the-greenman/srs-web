    "package/fields/doesnotfix-9b8c0d2c.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "Name the residual problem plainly.",
        "negativeGuidance": "Do not leave empty to look stronger, or restate the move.",
        "purpose": "The honest limit of a remedy: problems it does not touch or may worsen. Aligned with muSrs remedy."
      },
