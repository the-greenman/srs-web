    "package/fields/line-481bf75b.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "1, 2 or 3. Follow the line order the owner fixed for the compass (srs-context cc05d4c9) unless told otherwise.",
        "negativeGuidance": "Not a rank or a weight. Two affirmed axes of one domain never share a line.",
        "purpose": "Orders a domain's three axes so its leans read as a trigram."
      },
      "createdAt": "2026-10-22T12:00:00+00:00",
      "description": "Which line of the domain's trigram an axis is: 1, 2 or 3, line 1 at the bottom.",
