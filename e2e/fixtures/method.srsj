    "package/types/principle-eff00965.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "extraction": "statement = the default 'X over Y'; boundary_clause = when Y governs; source_ref points to the ratifying record, never copies it.",
        "negativeGuidance": "Never a replacement for the tension. If no boundary is ratified write 'None ratified yet: to be stated'.",
        "purpose": "Public words: leaning is 'default', boundary clause is 'unless'. governs one tension and leans-toward one of that tension's poles; may extend another principle. The boundary clause is required: a bare 'A over B' is not enough."
      },
      "createdAt": "2026-10-08T11:04:57.957Z",
