    "package/types/pole-e3b62684.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/type.json",
      "aiGuidance": {
        "extraction": "Title is the side's short name; copy no first-person or mystical source wording.",
        "negativeGuidance": "Both sides of a tension stay named and legitimate.",
        "purpose": "Public word: side. looks_like is what leaning on it looks like in plain third-person English; shadow (public word: overdone) is how it goes wrong when nothing balances it. Contained by exactly one tension."
      },
      "createdAt": "2026-10-08T11:04:57.889Z",
      "description": "One side of a tension.",
      "fields": [
