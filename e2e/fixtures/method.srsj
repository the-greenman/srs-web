    "package/fields/falsifier-b8b1f078.json": {
      "$schema": "https://srs.semanticops.com/schema/2.0/field.json",
      "aiGuidance": {
        "extraction": "Describe a concrete, observable result that would refute the remedy.",
        "negativeGuidance": "Not a restatement of the move or a vague risk.",
        "purpose": "An observation that would count against the remedy, so it can be tested. Aligned with muSrs remedy."
      },
      "createdAt": "2026-10-08T10:44:21.579760527+00:00",
      "description": "What would show a remedy does not work.",
      "fieldType": {
